# PostgreSQL (durable store, written behind by `backend flusher`)
POSTGRES_HOST               = localhost
POSTGRES_PORT               = 5432
POSTGRES_DB                 = generations
POSTGRES_USER               = postgres
POSTGRES_PASS               = postgres
POSTGRES_DRIVER             = psycopg
POSTGRES_POOL_SIZE          = 10
POSTGRES_MAX_OVERFLOW       = 10
POSTGRES_MAX_CONNECTIONS    = 150   # docker-compose only

# Redis (hot store for balances and generation records)
REDIS_HOST                  = localhost
REDIS_PORT                  = 6379
REDIS_DB                    = 0
# REDIS_PASSWORD            = your-redis-password   # optional

# Billing (all optional, defaults shown)
# GENERATION_RECORD_TTL_SECONDS  = 86400   # idempotency window for client_request_id
# TOP_UP_RECORD_TTL_SECONDS      = 86400   # idempotency window for operation_id
# RUNNING_WAIT_TIMEOUT_SECONDS   = 30.0    # how long a redelivery waits for an in-flight generation
# RUNNING_POLL_INTERVAL_SECONDS  = 0.02
# RESERVE_MAX_ATTEMPTS           = 100     # CAS retries before BalanceContentionError
# LOAD_LOCK_TTL_MS               = 5000    # cold-load lock lifetime
# LOAD_WAIT_TIMEOUT_SECONDS      = 15.0    # must exceed LOAD_LOCK_TTL_MS / 1000
# FLUSH_INTERVAL_SECONDS         = 1.0     # write-behind period of `backend flusher`
# FLUSH_BATCH_SIZE               = 500
# REAP_AFTER_SECONDS             = 300.0   # running reservation older than this is refunded by the flusher tick
# REAP_BATCH_SIZE                = 100
# RETRY_ATTEMPTS                 = 3       # transient Redis errors on settle/refund/forget_inflight
